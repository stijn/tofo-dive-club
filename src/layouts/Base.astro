---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url';
import manropeUrl from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { htmlLang, photos, srcset, langs, type Lang } from '../config';
import { t } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Path after the locale prefix, e.g. '' for the home page. */
  path?: string;
  noindex?: boolean;
  preloadHero?: boolean;
}
const { lang, title, description, path = '', noindex = false, preloadHero = false } = Astro.props;
const d = t(lang);
const pageTitle = title ?? d.meta.title;
const pageDescription = description ?? d.meta.description;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site!.origin;
const canonical = getAbsoluteLocaleUrl(lang, path);
const ogImage = `${site}${base}/og/og-${lang}.png`;
const hero = photos.heroWhaleShark;
---
<!doctype html>
<html lang={htmlLang[lang]} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <script is:inline>
      // Animations follow the saved choice, else the system's reduce-motion setting.
      (function () {
        var r = document.documentElement, s = null;
        try { s = localStorage.getItem('tdc-motion'); } catch (e) {}
        var off = s ? s === 'off' : matchMedia('(prefers-reduced-motion: reduce)').matches;
        r.classList.add(off ? 'motion-off' : 'js-motion');
      })();
    </script>
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large" />
        <link rel="canonical" href={canonical} />
        {langs.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={getAbsoluteLocaleUrl(l, path)} />)}
        <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en', path)} />
      </>
    )}

    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manropeUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" />
    {preloadHero && (
      <link
        rel="preload"
        as="image"
        imagesrcset={srcset(hero.id, [640, 960, 1280, 1600, 2000, 2560])}
        imagesizes="100vw"
        fetchpriority="high"
      />
    )}

    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/manifest-${lang}.webmanifest`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta name="theme-color" content="#04192a" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={lang === 'pt' ? 'Clube de Mergulho do Tofo' : 'Tofo Dive Club'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.meta.ogAlt} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_MZ' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'pt' ? 'en_GB' : 'pt_MZ'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={d.meta.ogAlt} />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{d.skip}</a>
    <slot />
  </body>
</html>
