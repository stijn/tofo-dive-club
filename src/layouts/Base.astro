---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { htmlLang, photos, unsplash, type Lang } from '../config';
import { t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = getAbsoluteLocaleUrl(lang, '');
const alternates = (['en', 'pt'] as Lang[]).map((l) => ({ hreflang: htmlLang[l], href: getAbsoluteLocaleUrl(l, '') }));
const ogImage = unsplash(photos.heroWhaleShark.id, 1200, 630 / 1200);
---
<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{d.meta.title}</title>
    <meta name="description" content={d.meta.description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en', '')} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <meta name="theme-color" content="#04192a" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={d.meta.title} />
    <meta property="og:description" content={d.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={d.meta.ogAlt} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_MZ' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-motion');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{d.skip}</a>
    <slot />
  </body>
</html>
