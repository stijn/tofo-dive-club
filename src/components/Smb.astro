---
// Back to top, dive style. Floating button for pointer users; the footer
// link does the same for keyboard users. Both run the same ascent.
import type { Lang } from '../config';
import { t } from '../i18n';
import SmbIcon from './SmbIcon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).smb;
---
<a class="smb-float" href="#top" data-tip={d.label} data-tip-side="left" data-tip-describe="false" data-ascend>
  <span class="visually-hidden">{d.label}</span>
  <SmbIcon />
</a>
<div class="safety-stop" aria-hidden="true" data-safety-stop>
  <span>{d.stop}</span>
  <strong data-safety-count>3:00</strong>
</div>
<div class="toast" role="status" data-toast data-message={d.toast}>
  <p data-toast-text></p>
  <button class="icon-btn toast-close" type="button" data-tip={d.close} data-tip-describe="false" data-toast-close>
    <span aria-hidden="true">×</span>
    <span class="visually-hidden">{d.close}</span>
  </button>
</div>

<script>
  import { motionOn } from '../scripts/motion-state';

  const root = document.documentElement;
  const float = document.querySelector<HTMLAnchorElement>('.smb-float')!;
  const stop = document.querySelector<HTMLElement>('[data-safety-stop]')!;
  const count = document.querySelector<HTMLElement>('[data-safety-count]')!;

  // Wide screens have room in the margin, so the buoy stays. Narrower screens show it
  // only while you scroll up, so it never sits on top of text you are reading.
  const wide = window.matchMedia('(min-width: 1360px)');
  let lastY = window.scrollY;
  const onScroll = () => {
    const y = window.scrollY;
    const deep = y > window.innerHeight * 1.2;
    if (!deep) float.classList.remove('is-visible');
    else if (wide.matches || y < lastY - 4) float.classList.add('is-visible');
    else if (y > lastY + 4 && !root.dataset.ascending) float.classList.remove('is-visible');
    lastY = y;
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Our own frame-by-frame scroll, so the ascent is one continuous, eased glide
  // (the browser's smooth scroll can't be timed or chained without stutter).
  const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
  let cancelled = false;
  const glide = (to: number, ms: number, ease: (t: number) => number) =>
    new Promise<void>((resolve) => {
      const from = window.scrollY;
      const start = performance.now();
      const step = (now: number) => {
        if (cancelled) return resolve();
        const t = Math.min(1, (now - start) / ms);
        window.scrollTo({ top: from + (to - from) * ease(t), behavior: 'instant' as ScrollBehavior });
        if (t < 1) requestAnimationFrame(step);
        else resolve();
      };
      requestAnimationFrame(step);
    });
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  // A visitor who scrolls, swipes or presses a key takes back control.
  const cancel = () => (cancelled = true);
  ['wheel', 'touchstart', 'keydown'].forEach((t) => window.addEventListener(t, cancel, { passive: true }));

  const focusTop = () => {
    const h1 = document.getElementById('hero-title') ?? document.querySelector('h1');
    (h1 as HTMLElement | null)?.focus({ preventScroll: true });
  };

  let busy = false;
  const ascend = async (e: Event) => {
    e.preventDefault();
    if (busy) return;
    if (!motionOn()) {
      window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
      focusTop();
      return;
    }
    busy = true;
    cancelled = false;
    root.dataset.ascending = '1';
    root.classList.add('is-ascending');
    float.classList.add('is-launching');

    // Rise to the 5 m safety stop (the club section), ease to a halt, hang there, then surface.
    const club = document.getElementById('club');
    const stopY = club ? Math.max(0, club.offsetTop - 80) : 0;
    const distance = window.scrollY - stopY;
    if (club && distance > window.innerHeight) {
      await glide(stopY, Math.min(1800, 700 + distance * 0.08), easeInOut);
      if (!cancelled) {
        stop.classList.add('is-on');
        const t0 = performance.now();
        await new Promise<void>((resolve) => {
          const tick = (now: number) => {
            const left = Math.max(0, 1 - (now - t0) / 900);
            count.textContent = `${Math.floor(left * 3)}:${String(Math.floor((left * 180) % 60)).padStart(2, '0')}`;
            if (left > 0 && !cancelled) requestAnimationFrame(tick);
            else resolve();
          };
          requestAnimationFrame(tick);
        });
        await wait(120);
        stop.classList.remove('is-on');
      }
    }
    if (!cancelled) await glide(0, Math.min(1000, 500 + window.scrollY * 0.3), easeOut);
    if (!cancelled) focusTop();
    float.classList.remove('is-launching');
    root.classList.remove('is-ascending');
    delete root.dataset.ascending;
    busy = false;
  };

  document.querySelectorAll<HTMLAnchorElement>('[data-ascend]').forEach((a) => a.addEventListener('click', ascend));
</script>
