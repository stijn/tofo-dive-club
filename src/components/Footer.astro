---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { club, photos, type Lang } from '../config';
import { t } from '../i18n';
import Mark from './Mark.astro';
import Fa from './Fa.astro';
import SmbIcon from './SmbIcon.astro';
import { faWhatsapp, faInstagram, faFacebookF } from '@fortawesome/free-brands-svg-icons';
import { faEnvelope } from '@fortawesome/free-regular-svg-icons';
import { faLocationDot } from '@fortawesome/free-solid-svg-icons';

interface Props { lang: Lang; minimal?: boolean }
const { lang, minimal = false } = Astro.props;
const d = t(lang);
const f = d.footer;
const social = [
  club.whatsapp && { href: `https://wa.me/${club.whatsapp}`, icon: faWhatsapp, label: 'WhatsApp' },
  club.email && { href: `mailto:${club.email}`, icon: faEnvelope, label: club.email },
  club.instagram && { href: club.instagram, icon: faInstagram, label: 'Instagram' },
  club.facebook && { href: club.facebook, icon: faFacebookF, label: 'Facebook' },
].filter(Boolean) as { href: string; icon: typeof faWhatsapp; label: string }[];
const credits = [...new Map(Object.values(photos).map((p) => [p.by, p])).values()];
const home = getRelativeLocaleUrl(lang, '');
const links = [
  ['club', d.nav.club], ['dives', d.nav.dives], ['sites', d.nav.sites], ['seasons', d.nav.seasons],
  ['offer', d.nav.offer], ['join', d.nav.join], ['faq', d.nav.faq], ['glossary', d.nav.glossary],
] as const;
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand" href={home} aria-label={d.nav.home}>
        <Mark />
        <span class="brand-name">{club.name[lang]}</span>
      </a>
      <p>{f.tagline}</p>
      <address class="footer-where">
        <span><Fa icon={faLocationDot} /> {f.where}</span>
        <a href={club.map} rel="noopener">{f.map}</a>
      </address>
      {social.length > 0 && (
        <ul class="social">
          {social.map((s) => (
            <li><a href={s.href} rel="noopener" aria-label={s.label} data-tip={s.label} data-tip-describe="false"><Fa icon={s.icon} /></a></li>
          ))}
        </ul>
      )}
    </div>

    {!minimal && (
      <nav class="footer-nav" aria-label={d.nav.footerLabel}>
        <ul>
          {links.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
        </ul>
      </nav>
    )}

    <div class="footer-meta">
      <p class="demo-note">{f.demo}</p>
      <p>
        {f.photos}:{' '}
        {credits.map((p, i) => <>{i > 0 && ', '}<a href={p.url} rel="noopener" aria-label={d.hero.creditLabel.replace('{by}', p.by)}>{p.by}</a></>)}
      </p>
      <p>{f.icons} · {f.built}</p>
      {!minimal && <p class="treat-hint">{d.treats.mantaHint}</p>}
      <a class="to-top" href="#top" data-ascend><SmbIcon /> <span>{f.top}</span></a>
    </div>
  </div>
</footer>
