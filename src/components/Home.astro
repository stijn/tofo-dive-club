---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Club from './Club.astro';
import Dives from './Dives.astro';
import Sites from './Sites.astro';
import Seasons from './Seasons.astro';
import Join from './Join.astro';
import Faq from './Faq.astro';
import Footer from './Footer.astro';
import Gauge from './Gauge.astro';
import type { Lang } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base lang={lang}>
  <Header lang={lang} />
  <Gauge lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <Club lang={lang} />
    <Dives lang={lang} />
    <Sites lang={lang} />
    <Seasons lang={lang} />
    <Join lang={lang} />
    <Faq lang={lang} />
  </main>
  <Footer lang={lang} />
  <script>
    import '../scripts/motion';
  </script>
</Base>
