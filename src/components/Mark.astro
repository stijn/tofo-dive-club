---
// Club mark: a manta ray in a porthole. Same drawing as public/favicon.svg.
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<svg class:list={['mark', cls]} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <circle cx="32" cy="32" r="30.5" fill="var(--mark-bg, #0a3d57)" />
  <circle cx="32" cy="32" r="29" fill="none" stroke="var(--mark-ring, #ff8a6e)" stroke-width="3.5" />
  <path
    fill="var(--mark-fg, #f5efe4)"
    d="M32 17.5c-6 0-12 5-27.5 11.8 13.2 2 20.8 6.6 24.3 12.4 1 1.8 2.1 4.3 3.2 7.3 1.1-3 2.2-5.5 3.2-7.3 3.5-5.8 11.1-10.4 24.3-12.4C44 22.5 38 17.5 32 17.5Z"
  />
  <path d="M32 47v10" stroke="var(--mark-fg, #f5efe4)" stroke-width="2.6" stroke-linecap="round" />
  <path d="M28.2 19.2c-2.6-1.9-3.1-4.6-1.4-6.6M35.8 19.2c2.6-1.9 3.1-4.6 1.4-6.6" fill="none" stroke="var(--mark-fg, #f5efe4)" stroke-width="3" stroke-linecap="round" />
</svg>
