---
import type { Lang } from '../config';
import Photo from './Photo.astro';
import { t } from '../i18n';
import { rich } from '../lib/rich';
import { diveCards, weekIcons, depths } from '../data';
import SectionHead from './SectionHead.astro';
import Fa from './Fa.astro';
import Line from './Line.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).dives;
// A small school of fish that swims along the thermocline wave (decoration).
const school = Array.from({ length: 9 }, (_, i) => ({
  x: (i % 3) * 22 + (i > 5 ? 10 : 0),
  y: Math.floor(i / 3) * 12 + (i % 2) * 4,
  s: 0.75 + ((i * 37) % 5) / 10,
}));
---
<section class="section dives" id="dives" data-depth={depths.dives} aria-labelledby="dives-title">
  <div class="container">
    <SectionHead lang={lang} id="dives" depth={depths.dives} kicker={d.kicker} title={d.title} lead={d.lead} />

    <ul class="cards">
      {d.cards.map((c) => {
        const meta = diveCards[c.id];
        return (
          <li class="card reveal">
            <figure class="card-photo">
              <Photo photo={meta.photo} widths={[400, 600, 750, 900]} ratio={0.75} sizes="(min-width: 1100px) 280px, (min-width: 640px) 45vw, 92vw" alt={c.alt} />
            </figure>
            <div class="card-body">
              <span class="card-icon"><Fa icon={meta.icon} /></span>
              <h3>{c.title}</h3>
              <p set:html={rich(c.text, lang)} />
              <span class="tag">{c.tag}</span>
            </div>
          </li>
        );
      })}
    </ul>

    <div class="week reveal">
      <div class="week-head">
        <h3><Line name="calendar" /> {d.weekTitle}</h3>
        <p>{d.weekNote}</p>
      </div>
      <ol class="week-list">
        {d.week.map((w) => (
          <li>
            <span class="week-day"><abbr title={w.dayLong}>{w.day}</abbr></span>
            <span class="week-time">{w.time}</span>
            <span class="week-what"><Fa icon={weekIcons[w.id]} /> {w.what}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
  <div class="school" aria-hidden="true">
    {school.map((f) => (
      <svg class="fish" viewBox="0 0 24 12" style={`--x:${f.x}px;--y:${f.y}px;--s:${f.s}`}>
        <path d="M22 6c-4-5-11-5-15 0 4 5 11 5 15 0Zm-15 0-5-4v8Z" fill="currentColor" />
      </svg>
    ))}
  </div>
  <svg class="thermocline" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 50c120 22 240 30 360 18S600 20 720 26s240 42 360 40 240-34 360-30v54H0Z" fill="currentColor" opacity=".35" />
    <path d="M0 62c160 18 300 22 440 8s260-40 400-30 260 44 380 40 160-20 220-22v32H0Z" fill="currentColor" />
  </svg>
</section>
