---
// Surface marker buoy: the orange tube divers send up so the boat can find them.
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<svg class:list={['smb-icon', cls]} viewBox="0 0 24 52" aria-hidden="true" focusable="false">
  <rect class="smb-tube" x="5" y="2" width="14" height="36" rx="7" />
  <rect class="smb-band" x="5" y="9" width="14" height="3.2" />
  <rect class="smb-band" x="5" y="27" width="14" height="3.2" />
  <path class="smb-shine" d="M8.5 6v26" />
  <rect class="smb-valve" x="9.5" y="37" width="5" height="4" rx="1" />
  <path class="smb-line" d="M12 41v5c0 2.5-3 2.5-3 4.5" />
</svg>
