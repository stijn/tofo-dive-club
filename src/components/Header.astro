---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { club, htmlLang, type Lang } from '../config';
import { t } from '../i18n';
import Mark from './Mark.astro';
import Line from './Line.astro';

interface Props { lang: Lang; minimal?: boolean }
const { lang, minimal = false } = Astro.props;
const d = t(lang);
const other: Lang = lang === 'en' ? 'pt' : 'en';
const home = getRelativeLocaleUrl(lang, '');
const links = [
  ['club', d.nav.club],
  ['dives', d.nav.dives],
  ['sites', d.nav.sites],
  ['seasons', d.nav.seasons],
  ['offer', d.nav.offer],
  ['faq', d.nav.faq],
] as const;
---
<header class="site-header" data-header>
  <div class="container header-bar">
    <a class="brand" href={home} aria-label={d.nav.home} data-brand>
      <Mark />
      <span class="brand-name">{club.name[lang]}</span>
    </a>

    <nav class="nav" id="site-nav" aria-label={d.nav.label}>
      {!minimal && (
        <ul>
          {links.map(([id, label]) => <li><a href={`#${id}`} data-spy={id}>{label}</a></li>)}
        </ul>
      )}
      <div class="nav-tools">
        <button class="icon-btn motion-btn" type="button" aria-pressed="false" data-tip={d.motion.pause} data-tip-describe="false" data-label-pause={d.motion.pause} data-label-play={d.motion.play} data-motion-btn>
          <span class="visually-hidden">{d.motion.pause}</span>
          <span class="motion-icon motion-icon-pause"><Line name="play-to-pause-transition" /></span>
          <span class="motion-icon motion-icon-play"><Line name="pause-to-play-transition" /></span>
        </button>
        {!minimal && <a class="btn btn-coral btn-small nav-join" href="#join">{d.nav.join}</a>}
      </div>
    </nav>

    <div class="header-tools">
      <a
        class="icon-btn lang-switch"
        href={getRelativeLocaleUrl(other, '')}
        hreflang={htmlLang[other]}
        lang={htmlLang[other]}
        aria-label={d.lang.otherLabel}
        data-tip={d.lang.tip}
        data-tip-describe="false"
        data-lang-switch
      >{d.lang.other}</a>
      {!minimal && (
        <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-tip={d.nav.menuOpen} data-tip-describe="false" data-label-open={d.nav.menuOpen} data-label-close={d.nav.menuClose} data-menu-btn>
          <span class="visually-hidden">{d.nav.menu}</span>
          <span class="menu-icon menu-icon-open"><Line name="menu-to-close-transition" /></span>
          <span class="menu-icon menu-icon-closed"><Line name="close-to-menu-transition" /></span>
        </button>
      )}
    </div>
  </div>
</header>

<script>
  import { setMotion, motionOn } from '../scripts/motion-state';
  import { setTip } from '../scripts/tooltips';

  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const motionBtn = document.querySelector<HTMLButtonElement>('[data-motion-btn]')!;
  const headerH = () => header.getBoundingClientRect().height;

  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu ------------------------------------------------------
  if (btn) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      header.classList.toggle('is-open', open);
      setTip(btn, (open ? btn.dataset.labelClose : btn.dataset.labelOpen)!);
      const icon = btn.querySelector<SVGSVGElement>(open ? '.menu-icon-open svg' : '.menu-icon-closed svg');
      if (motionOn()) icon?.setCurrentTime?.(0);
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    header.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('is-open')) {
        setOpen(false);
        btn.focus();
      }
    });
  }

  // Pause / play every animation (WCAG 2.2.2 and 2.3.3) -------------
  const labels = { pause: motionBtn.dataset.labelPause!, play: motionBtn.dataset.labelPlay! };
  const syncMotionBtn = () => {
    const on = motionOn();
    motionBtn.setAttribute('aria-pressed', String(!on));
    const label = on ? labels.pause : labels.play;
    setTip(motionBtn, label);
    motionBtn.querySelector('.visually-hidden')!.textContent = label;
  };
  syncMotionBtn();
  motionBtn.addEventListener('click', () => {
    setMotion(!motionOn());
    syncMotionBtn();
  });

  // Show where you are: mark the nav link of the section in view (2.4.8)
  const spyLinks = [...header.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
  const spyTargets = spyLinks.map((a) => document.getElementById(a.dataset.spy!)).filter(Boolean) as HTMLElement[];
  if (spyTargets.length) {
    const spy = () => {
      const line = headerH() + window.innerHeight * 0.25;
      let current: string | null = null;
      for (const s of spyTargets) if (s.getBoundingClientRect().top <= line) current = s.id;
      spyLinks.forEach((a) => (a.dataset.spy === current ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    };
    spy();
    window.addEventListener('scroll', spy, { passive: true });
  }

  // Never let the fixed header cover the focused element (2.4.12)
  // Only for keyboard focus on normal-sized elements: a mouse click on plain text
  // focuses <main> (it's the skip link's target), and scrolling to *its* top
  // used to throw the reader back to the top of the page.
  document.addEventListener('focusin', (e) => {
    const el = e.target as HTMLElement;
    if (!el || header.contains(el) || !el.matches(':focus-visible')) return;
    if (el === document.getElementById('main') || el.offsetHeight > window.innerHeight * 0.6) return;
    const r = el.getBoundingClientRect();
    const top = headerH() + 12;
    if (r.top < top) window.scrollBy({ top: r.top - top, behavior: 'instant' as ScrollBehavior });
  });

  // Keep the visitor's place when switching language.
  document.querySelector<HTMLAnchorElement>('[data-lang-switch]')?.addEventListener('click', (e) => {
    const a = e.currentTarget as HTMLAnchorElement;
    const current = [...document.querySelectorAll<HTMLElement>('main section[id]')]
      .filter((s) => s.getBoundingClientRect().top < window.innerHeight / 2)
      .pop();
    if (current) a.href = a.href.split('#')[0] + '#' + current.id;
  });
</script>
