---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { club, type Lang } from '../config';
import { t } from '../i18n';
import Mark from './Mark.astro';
import Line from './Line.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const other: Lang = lang === 'en' ? 'pt' : 'en';
const links = [
  ['club', d.nav.club],
  ['dives', d.nav.dives],
  ['sites', d.nav.sites],
  ['seasons', d.nav.seasons],
  ['faq', d.nav.faq],
] as const;
---
<header class="site-header" data-header>
  <div class="container header-bar">
    <a class="brand" href={getRelativeLocaleUrl(lang, '')} aria-label={d.nav.home}>
      <Mark />
      <span class="brand-name">{club.name[lang]}</span>
    </a>

    <nav class="nav" id="site-nav" aria-label="Main">
      <ul>
        {links.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
      </ul>
      <a class="btn btn-coral btn-small nav-join" href="#join">{d.nav.join}</a>
    </nav>

    <div class="header-tools">
      <a
        class="lang-switch"
        href={getRelativeLocaleUrl(other, '')}
        hreflang={other === 'pt' ? 'pt-MZ' : 'en'}
        lang={other === 'pt' ? 'pt-MZ' : 'en'}
        aria-label={d.lang.otherLabel}
        title={d.lang.otherLabel}
        data-lang-switch
      >
        <span aria-hidden="true">{d.lang.other}</span>
      </a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-btn>
        <span class="visually-hidden">{d.nav.menu}</span>
        <span class="menu-icon menu-icon-open"><Line name="menu-to-close-transition" /></span>
        <span class="menu-icon menu-icon-closed"><Line name="close-to-menu-transition" /></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')!;

  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    header.classList.toggle('is-open', open);
    // Replay the line-md menu/close transition that just became visible.
    const icon = btn.querySelector<SVGSVGElement>(open ? '.menu-icon-open svg' : '.menu-icon-closed svg');
    icon?.setCurrentTime?.(0);
  };
  btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  header.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header.classList.contains('is-open')) {
      setOpen(false);
      btn.focus();
    }
  });

  // Keep the visitor's place when switching language.
  document.querySelector<HTMLAnchorElement>('[data-lang-switch]')?.addEventListener('click', (e) => {
    const a = e.currentTarget as HTMLAnchorElement;
    const current = [...document.querySelectorAll<HTMLElement>('main section[id]')]
      .filter((s) => s.getBoundingClientRect().top < window.innerHeight / 2)
      .pop();
    if (current) a.href = a.href.split('#')[0] + '#' + current.id;
  });
</script>
