---
// Font Awesome Free icon, rendered as inline SVG at build time (no runtime JS or webfont).
import type { IconDefinition } from '@fortawesome/free-solid-svg-icons';

interface Props {
  icon: IconDefinition;
  class?: string;
  label?: string;
}
const { icon, class: cls, label } = Astro.props;
const [w, h, , , path] = icon.icon;
const paths = Array.isArray(path) ? path : [path];
---
<svg
  class:list={['icon icon-fa', cls]}
  viewBox={`0 0 ${w} ${h}`}
  width={(w / h).toFixed(3) + 'em'}
  height="1em"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>{paths.map((d) => <path fill="currentColor" d={d} />)}</svg>
