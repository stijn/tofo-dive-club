---
import type { Lang } from '../config';
import { t } from '../i18n';
import { rich } from '../lib/rich';
import { sites, maxDepth, depths } from '../data';
import SectionHead from './SectionHead.astro';
import Line from './Line.astro';
import { whaleShark } from '../lib/whale-shark';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).sites;
const ticks = [0, 10, 20, 30];
---
<section class="section sites deep" id="sites" data-depth={depths.sites} aria-labelledby="sites-title">
  <div class="bubbles" aria-hidden="true"></div>
  <div class="shark-pass" aria-hidden="true" set:html={whaleShark} />
  <div class="container">
    <SectionHead lang={lang} id="sites" depth={depths.sites} kicker={d.kicker} title={d.title} lead={d.lead} />

    <div class="profile">
      <div class="profile-axis" aria-hidden="true">
        {ticks.map((m) => <span style={`--at:${m / maxDepth}`}>{m} m</span>)}
      </div>
      <div class="probe" aria-hidden="true" data-probe><span class="probe-label" data-probe-label>0 m</span></div>
      <ol class="site-list" data-max-depth={maxDepth}>
        {d.list.map((s) => {
          const { depth: [min, max], level } = sites[s.id];
          return (
            <li class={`site reveal level-${level}`} style={`--min:${min / maxDepth};--max:${max / maxDepth}`} data-min={min} data-max={max}>
              <div class="site-track" aria-hidden="true"><span class="site-range"></span></div>
              <div class="site-body">
                <h3>{s.name}</h3>
                <p class="site-meta">
                  <span class="site-depth">
                    <span class="visually-hidden">{d.depth}: </span>
                    {min === 0 ? d.surface : <>{min}–{max} <abbr title={d.metres}>m</abbr></>}
                  </span>
                  <span class="tag">{d.levels[level]}</span>
                </p>
                <p set:html={rich(s.text, lang)} />
              </div>
            </li>
          );
        })}
      </ol>
    </div>
    <p class="note reveal"><Line name="alert-circle" /> <span set:html={rich(d.note, lang)} /></p>
  </div>
</section>
