---
import type { Lang } from '../config';
import Photo from './Photo.astro';
import { t } from '../i18n';
import { rich } from '../lib/rich';
import { manta } from '../lib/creatures';
import { seasons, waterTemp, depths } from '../data';
import SectionHead from './SectionHead.astro';
import Line from './Line.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).seasons;
const levelText = [d.legend.unlikely, d.legend.possible, d.legend.peak];
const rows = (['sharks', 'mantas', 'whales'] as const).map((k) => ({ key: k, name: d.rows[k], values: seasons[k] }));
---
<section class="section seasons deep" id="seasons" data-depth={depths.seasons} aria-labelledby="seasons-title">
  <div class="bubbles" aria-hidden="true"></div>
  <div class="glider" aria-hidden="true" set:html={manta} />
  <div class="container">
    <div class="seasons-top">
      <SectionHead lang={lang} id="seasons" depth={depths.seasons} kicker={d.kicker} title={d.title} lead={d.lead} />
      <figure class="whale reveal">
        <Photo photo="humpback" widths={[400, 640, 750, 960]} ratio={0.5625} sizes="(min-width: 960px) 420px, 92vw" alt={d.photoAlt} />
        <figcaption><Line name="alert-circle" /> {d.note}</figcaption>
      </figure>
    </div>

    <div class="season-wrap reveal" data-season-wrap>
      <table class="season-table">
        <caption class="visually-hidden">{d.caption}</caption>
        <thead>
          <tr>
            <td></td>
            {d.months.map((m, i) => (
              <th scope="col" data-month={i}>
                <abbr title={d.monthsLong[i]}><span class="m-long">{m}</span><span class="m-short" aria-hidden="true">{m.charAt(0)}</span></abbr>
                <span class="now-flag" aria-hidden="true">{d.now}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr data-row={r.key}>
              <th scope="row">{r.name}</th>
              {r.values.map((v, i) => (
                <td data-month={i} class={`lvl lvl-${v}`}>
                  <span class="dot" aria-hidden="true"></span>
                  <span class="visually-hidden">{levelText[v]}</span>
                </td>
              ))}
            </tr>
          ))}
          <tr class="temp-row" data-row="temp">
            <th scope="row" set:html={rich(d.rows.temp, lang)} />
            {waterTemp.map((c, i) => (
              <td data-month={i} style={`--warm:${(c - 21) / 7}`}><span>{c}</span></td>
            ))}
          </tr>
        </tbody>
      </table>
    </div>

    <ul class="legend reveal" aria-hidden="true">
      <li><span class="dot lvl-2"></span>{d.legend.peak}</li>
      <li><span class="dot lvl-1"></span>{d.legend.possible}</li>
      <li><span class="dot lvl-0"></span>{d.legend.unlikely}</li>
    </ul>
    <p class="note reveal"><Line name="alert-circle" /> <span>{d.decline}</span></p>
  </div>
</section>

<script>
  // Mark the current month (visitor's clock, so it stays right after the build date).
  const m = new Date().getMonth();
  document.querySelectorAll<HTMLElement>(`.season-table [data-month="${m}"]`).forEach((el) => el.classList.add('is-now'));
</script>
