---
import { club, type Lang } from '../config';
import { t } from '../i18n';
import { depths, formLanguages } from '../data';
import SectionHead from './SectionHead.astro';
import Line from './Line.astro';
import Fa from './Fa.astro';
import { faWhatsapp } from '@fortawesome/free-brands-svg-icons';
import { faEnvelope } from '@fortawesome/free-regular-svg-icons';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).join;
const f = d.form;
const stepIcons = ['account-add', 'chat-round-dots', 'water'];
const strings = {
  name: f.name, email: f.email, cert: f.cert, dives: f.dives, stay: f.stay,
  dates: f.dates, interests: f.interests, message: f.message, language: f.language,
  intro: f.intro, subject: f.subject,
};
---
<section class="section join deep" id="join" data-depth={depths.join} aria-labelledby="join-title">
  <div class="bubbles" aria-hidden="true"></div>
  <div class="container join-grid">
    <div>
      <SectionHead lang={lang} id="join" depth={depths.join} kicker={d.kicker} title={d.title} lead={d.lead} />
      <ol class="steps">
        {d.steps.map((s, i) => (
          <li class="step reveal">
            <span class="step-icon"><Line name={stepIcons[i]} /></span>
            <div>
              <h3><span class="step-n">{i + 1}</span> {s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <form
      class="join-form reveal"
      data-join-form
      data-whatsapp={club.whatsapp}
      data-email={club.email}
      data-strings={JSON.stringify(strings)}
      aria-labelledby="join-title"
      novalidate
    >
      <div class="field">
        <label for="f-name">{f.name} <span class="req">({f.required})</span></label>
        <p class="hint" id="f-name-hint">{f.nameHint}</p>
        <input id="f-name" name="name" autocomplete="given-name" required aria-required="true" aria-describedby="f-name-hint f-name-error" />
        <p class="error" id="f-name-error" hidden><Line name="alert-circle" /> {f.nameError}</p>
      </div>
      <div class="field">
        <label for="f-email">{f.email} <span class="opt">({f.optional})</span></label>
        <p class="hint" id="f-email-hint">{f.emailHint}</p>
        <input id="f-email" name="email" type="email" autocomplete="email" aria-describedby="f-email-hint" />
      </div>
      <div class="field-row">
        <div class="field">
          <label for="f-cert">{f.cert}</label>
          <p class="hint" id="f-cert-hint">{f.certHint}</p>
          <select id="f-cert" name="cert" aria-describedby="f-cert-hint">
            {f.certOptions.map((o) => <option>{o}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="f-dives">{f.dives}</label>
          <p class="hint" id="f-dives-hint">{f.divesHint}</p>
          <select id="f-dives" name="dives" aria-describedby="f-dives-hint">
            {f.diveOptions.map((o) => <option>{o}</option>)}
          </select>
        </div>
      </div>
      <fieldset class="field">
        <legend>{f.stay}</legend>
        <div class="chips">
          {f.stayOptions.map((o, i) => (
            <label class="chip">
              <input type="radio" name="stay" value={o} checked={i === 0} />
              <span>{o}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <div class="field" data-dates>
        <label for="f-dates">{f.dates} <span class="opt">({f.optional})</span></label>
        <p class="hint" id="f-dates-hint">{f.datesHint}</p>
        <input id="f-dates" name="dates" placeholder={f.datesPlaceholder} aria-describedby="f-dates-hint" />
      </div>
      <fieldset class="field">
        <legend>{f.interests} <span class="opt">({f.optional})</span></legend>
        <div class="chips">
          {f.interestOptions.map((o) => (
            <label class="chip">
              <input type="checkbox" name="interests" value={o} />
              <span>{o}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <div class="field-row">
        <div class="field">
          <label for="f-language">{f.language}</label>
          <p class="hint" id="f-language-hint">{f.languageHint}</p>
          <select id="f-language" name="language" aria-describedby="f-language-hint">
            {formLanguages.map((l) => <option value={l.value} lang={l.lang} selected={l.value === lang}>{l.name}</option>)}
            <option value="other">{f.languageOther}</option>
          </select>
        </div>
        <div class="field field-end" data-language-other hidden>
          <label for="f-language-other">{f.languageOtherLabel}</label>
          <input id="f-language-other" name="languageOther" autocomplete="off" />
        </div>
      </div>
      <div class="field">
        <label for="f-message">{f.message} <span class="opt">({f.optional})</span></label>
        <p class="hint" id="f-message-hint">{f.messageHint}</p>
        <textarea id="f-message" name="message" rows="3" aria-describedby="f-message-hint"></textarea>
      </div>
      <p class="form-actions-hint" id="f-actions-hint"><Line name="alert-circle" /> {f.actionsHint}</p>
      <div class="form-actions">
        <button class="btn btn-coral btn-bubbles" type="submit" value="whatsapp" aria-describedby="f-actions-hint">
          <Fa icon={faWhatsapp} /> {f.whatsapp}
        </button>
        <button class="btn btn-ghost" type="submit" value="email" aria-describedby="f-actions-hint">
          <Fa icon={faEnvelope} /> {f.emailSend}
        </button>
      </div>
      <p class="form-privacy">{f.privacy}</p>
      <div class="form-done" data-form-done role="status" tabindex="-1">
        <div class="stamp" aria-hidden="true"><Line name="confirm-circle" class="done-icon" /></div>
        <div data-done-body hidden>
          <strong>{f.doneTitle}</strong>
          <p>{f.doneText}</p>
          <p class="form-offline" data-done-offline hidden><Line name="alert-circle" /> {t(lang).data.offlineForm}</p>
        </div>
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-join-form]')!;
  const s = JSON.parse(form.dataset.strings!) as Record<string, string>;
  const done = form.querySelector<HTMLElement>('[data-form-done]')!;
  const doneBody = done.querySelector<HTMLElement>('[data-done-body]')!;
  const dates = form.querySelector<HTMLElement>('[data-dates]')!;
  const name = form.elements.namedItem('name') as HTMLInputElement;
  const nameError = document.getElementById('f-name-error')!;

  // Only ask for dates when someone is visiting or planning a trip.
  const syncDates = () => {
    const first = form.querySelector<HTMLInputElement>('input[name="stay"]')!;
    dates.hidden = first.checked;
  };
  form.addEventListener('change', syncDates);
  syncDates();

  // "Another language" opens a text field for it.
  const language = form.elements.namedItem('language') as HTMLSelectElement;
  const languageOther = form.querySelector<HTMLElement>('[data-language-other]')!;
  const syncLanguage = () => (languageOther.hidden = language.value !== 'other');
  language.addEventListener('change', syncLanguage);
  syncLanguage();

  const setError = (on: boolean) => {
    nameError.hidden = !on;
    if (on) name.setAttribute('aria-invalid', 'true');
    else name.removeAttribute('aria-invalid');
  };
  name.addEventListener('input', () => name.value.trim() && setError(false));

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!name.value.trim()) {
      setError(true);
      name.focus();
      return;
    }
    setError(false);

    const data = new FormData(form);
    const lines = [s.intro, ''];
    const add = (label: string, value: string) => value.trim() && lines.push(`${label}: ${value.trim()}`);
    add(s.name, String(data.get('name') ?? ''));
    add(s.email, String(data.get('email') ?? ''));
    add(s.cert, String(data.get('cert') ?? ''));
    add(s.dives, String(data.get('dives') ?? ''));
    add(s.stay, String(data.get('stay') ?? ''));
    if (!dates.hidden) add(s.dates, String(data.get('dates') ?? ''));
    add(s.interests, data.getAll('interests').join(', '));
    add(s.language, language.value === 'other' ? String(data.get('languageOther') ?? '') : language.selectedOptions[0].text);
    add(s.message, String(data.get('message') ?? ''));
    const text = lines.join('\n');

    const via = (e.submitter as HTMLButtonElement | null)?.value ?? 'whatsapp';
    if (via === 'email') {
      const to = form.dataset.email ?? '';
      window.location.href = `mailto:${to}?subject=${encodeURIComponent(s.subject)}&body=${encodeURIComponent(text)}`;
    } else {
      const number = (form.dataset.whatsapp ?? '').replace(/\D/g, '');
      window.open(`https://wa.me/${number}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
    }

    // The status region already exists, so screen readers announce the new text.
    doneBody.hidden = false;
    doneBody.querySelector<HTMLElement>('[data-done-offline]')!.hidden = navigator.onLine;
    done.classList.add('is-done');
    done.querySelector<SVGSVGElement>('svg')?.setCurrentTime?.(0);
    document.dispatchEvent(new CustomEvent('tdc:logged', { detail: done }));
  });
</script>
