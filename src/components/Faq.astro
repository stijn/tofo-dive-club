---
import type { Lang } from '../config';
import { t } from '../i18n';
import { rich } from '../lib/rich';
import { depths } from '../data';
import SectionHead from './SectionHead.astro';
import Line from './Line.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).faq;
---
<section class="section faq deep" id="faq" data-depth={depths.faq} aria-labelledby="faq-title">
  <div class="container faq-grid">
    <SectionHead lang={lang} id="faq" depth={depths.faq} kicker={d.kicker} title={d.title}>
      <p class="faq-glossary reveal"><a href="#glossary"><Line name="text-box-multiple" /> {d.glossaryLink}</a></p>
    </SectionHead>
    <div class="faq-list">
      {d.items.map((item) => (
        <details class="faq-item reveal">
          <summary>
            <span>{item.q}</span>
            <Line name="chevron-small-down" class="faq-chevron" />
          </summary>
          <p set:html={rich(item.a, lang)} />
        </details>
      ))}
    </div>
  </div>
</section>
