---
import type { Lang } from '../config';
import { t } from '../i18n';
import { depths } from '../data';
import SectionHead from './SectionHead.astro';
import Line from './Line.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).faq;
---
<section class="section faq deep" id="faq" data-depth={depths.faq} aria-labelledby="faq-title">
  <div class="container faq-grid">
    <SectionHead id="faq" depth={depths.faq} kicker={d.kicker} title={d.title} />
    <div class="faq-list">
      {d.items.map((item) => (
        <details class="faq-item reveal">
          <summary>
            <span>{item.q}</span>
            <Line name="chevron-small-down" class="faq-chevron" />
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
