---
import type { Lang } from '../config';
import Photo from './Photo.astro';
import { t } from '../i18n';
import { pillarIcons, depths } from '../data';
import { rich } from '../lib/rich';
import SectionHead from './SectionHead.astro';
import Fa from './Fa.astro';
import Line from './Line.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).club;
---
<section class="section club" id="club" data-depth={depths.club} aria-labelledby="club-title">
  <div class="container club-grid">
    <div>
      <SectionHead lang={lang} id="club" depth={depths.club} kicker={d.kicker} title={d.title} lead={d.lead} />
      <ul class="pillars">
        {d.pillars.map((p) => (
          <li class="pillar reveal">
            <span class="pillar-icon"><Fa icon={pillarIcons[p.id]} /></span>
            <h3>{p.title}</h3>
            <p set:html={rich(p.text, lang)} />
          </li>
        ))}
      </ul>
    </div>

    <div class="club-media">
      <figure class="photo photo-tall reveal">
        <Photo photo="diverSigns" widths={[400, 600, 800, 1100]} ratio={1.25} sizes="(min-width: 960px) 34vw, (min-width: 600px) 300px, calc(55vw - 25px)" alt={d.photoAlt} />
      </figure>
      <figure class="photo photo-wide reveal">
        <Photo photo="tofoBeach" widths={[400, 700, 1000]} ratio={1.1} sizes="(min-width: 960px) 22vw, (min-width: 600px) 245px, calc(45vw - 20px)" alt={d.beachAlt} />
      </figure>
      <aside class="founder reveal">
        <Line name="heart" class="founder-icon" />
        <h3>{d.founderTitle}</h3>
        <p>{d.founderText}</p>
      </aside>
    </div>
  </div>
</section>
