---
// On a language page that isn't finished yet (Gitonga): how far along it is,
// and where the translator gets the sheet. Only people with the link see this page.
import { tohProgress } from '../i18n/progress';
import Line from './Line.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const sheet = `${base}translations/gitonga.csv`;
const help = 'https://github.com/stijn/tofo-dive-club/blob/main/translations/README.md';
const { done, total } = tohProgress;
---
<aside class="translation-note" aria-labelledby="translation-note-title">
  <div class="container">
    <h2 id="translation-note-title"><Line name="text-box-multiple" /> Gitonga</h2>
    <p lang="pt-MZ">
      Esta versão está a ser traduzida para gitonga: <strong>{done} de {total}</strong> textos prontos.
      Até estar completa, o texto aparece em português e a página não aparece no menu nem nas pesquisas.
      <a href={sheet} download>Descarregar a folha de tradução (CSV)</a> · <a href={help} lang="en">Como funciona</a>
    </p>
    <p lang="en">
      This version is being translated into Gitonga: <strong>{done} of {total}</strong> texts done.
      Until it’s complete, the text shows in Portuguese and the page stays out of the menu and search results.
      <a href={sheet} download>Download the translation sheet (CSV)</a> · <a href={help}>How it works</a>
    </p>
    <progress max={total} value={done} aria-label="Gitonga">{done} / {total}</progress>
  </div>
</aside>
